# cmaketris.cmake - a falling-block puzzle game written in CMake's scripting language.
#
#   cmake -DFIFO=<pipe prefix> -DSCRATCH=<file> -P cmaketris.cmake
#
# Events (../SPEC.md: the seed first, then 0 tick, 1 left, 2 right, 3 rotate,
# 4 soft drop, 5 hard drop, 9 quit) arrive through named pipes FIFO.0, FIFO.1, ...,
# one per read. file(READ) and file(STRINGS) can't read a pipe (they see an empty
# file), but file(DOWNLOAD "file://...") goes through the libcurl built into CMake,
# which blocks until a writer arrives and reads to end of file. So each pipe is
# "downloaded" into SCRATCH and then read with file(READ).
# Frames are written with file(APPEND /dev/stdout ...), which writes the bytes
# exactly as given, without adding a newline.
#
# State is ordinary variables: b_0 ... b_199 for the board, plus cur, nxt, x, y,
# r, t, score, lines, over. math(EXPR) is 64-bit and has bit operators, so the
# masks from SPEC.md are tested with (mask >> bit) & 1.
cmake_minimum_required(VERSION 3.10)

if(NOT DEFINED FIFO OR NOT DEFINED SCRATCH)
  message(FATAL_ERROR "usage: cmake -DFIFO=<pipe prefix> -DSCRATCH=<file> -P cmaketris.cmake")
endif()

# ---- tables -----------------------------------------------------------------
set(MASKS 240 17476 3840 8738  102 102 102 102  114 610 624 562  54 1122 864 561
          99 612 1584 306  113 550 1136 802  116 1570 368 547)
set(COLOURS 51 226 135 46 196 33 208)
set(POINTS 0 40 100 300 1200)
set(KICKS 0 -1 1 -2 2)

# ---- output pieces --------------------------------------------------------------
string(ASCII 27 ESC)
set(R "${ESC}[m")
set(K "${ESC}[K\n")
set(B "${ESC}[38;5;60m")
set(D "${ESC}[38;5;244m")
set(W "${ESC}[1m")
set(cell_0 "${ESC}[38;5;237m ·${R}")
foreach(p RANGE 6)
  math(EXPR v "${p} + 1")
  list(GET COLOURS ${p} c)
  set(cell_${v} "${ESC}[38;5;${c}m██${R}")
endforeach()
set(panel_0 "   ${B}╭──${R} ${D}next${R} ${B}──────╮${R}")
set(panel_1 "   ${B}│${R}              ${B}│${R}")
set(panel_6 "${panel_1}")
set(panel_7 "   ${B}╰──────────────╯${R}")
set(panel_9 "   ${D}score${R}")
set(panel_13 "   ${D}controls${R}")
set(panel_14 "   ${W}← a${R}  ${D}move left${R}")
set(panel_15 "   ${W}→ d${R}  ${D}move right${R}")
set(panel_16 "   ${W}↑ w${R}  ${D}rotate${R}")
set(panel_17 "   ${W}↓ s${R}  ${D}soft drop${R}")
set(panel_18 "   ${W}␣ z${R}  ${D}hard drop${R}")
set(panel_19 "   ${W}  q${R}  ${D}quit${R}")

# ---- game -----------------------------------------------------------------------
# Park-Miller: s = s * 16807 mod (2^31 - 1); the next piece is s mod 7
macro(draw)
  math(EXPR s "${s} * 16807 % 2147483647")
  math(EXPR nxt "${s} % 7")
endmacro()

# fits(x y rot) -> ok
macro(fits _px _py _pr)
  math(EXPR _i "${cur} * 4 + ${_pr}")
  list(GET MASKS ${_i} _m)
  set(ok 1)
  foreach(_b RANGE 15)
    math(EXPR _bit "(${_m} >> ${_b}) & 1")
    if(_bit)
      math(EXPR _fx "${_px} + ${_b} % 4")
      math(EXPR _fy "${_py} + ${_b} / 4")
      if(_fx LESS 0 OR _fx GREATER 9 OR _fy LESS 0 OR _fy GREATER 19)
        set(ok 0)
      else()
        math(EXPR _k "${_fy} * 10 + ${_fx}")
        if(NOT b_${_k} EQUAL 0)
          set(ok 0)
        endif()
      endif()
    endif()
  endforeach()
endmacro()

# paint(v): write v into the current piece's cells
macro(paint _v)
  math(EXPR _i "${cur} * 4 + ${r}")
  list(GET MASKS ${_i} _m)
  foreach(_b RANGE 15)
    math(EXPR _bit "(${_m} >> ${_b}) & 1")
    if(_bit)
      math(EXPR _k "(${y} + ${_b} / 4) * 10 + ${x} + ${_b} % 4")
      set(b_${_k} ${_v})
    endif()
  endforeach()
endmacro()

macro(spawn)
  set(x 3)
  set(y 0)
  set(r 0)
  set(t 0)
  fits(3 0 0)
  if(NOT ok)
    set(over 1)
  endif()
endmacro()

# lock: paint, copy the rows that aren't full down to dst, clear the rest, score
macro(lock)
  math(EXPR _v "${cur} + 1")
  paint(${_v})
  set(_dst 19)
  foreach(_src RANGE 19 0 -1)
    set(_cnt 0)
    foreach(_j RANGE 9)
      math(EXPR _k "${_src} * 10 + ${_j}")
      if(NOT b_${_k} EQUAL 0)
        math(EXPR _cnt "${_cnt} + 1")
      endif()
    endforeach()
    if(_cnt LESS 10)
      foreach(_j RANGE 9)
        math(EXPR _k "${_src} * 10 + ${_j}")
        math(EXPR _kd "${_dst} * 10 + ${_j}")
        set(b_${_kd} ${b_${_k}})
      endforeach()
      math(EXPR _dst "${_dst} - 1")
    endif()
  endforeach()
  math(EXPR _cl "${_dst} + 1")
  math(EXPR _top "${_cl} * 10 - 1")
  if(_top GREATER_EQUAL 0)
    foreach(_k RANGE ${_top})
      set(b_${_k} 0)
    endforeach()
  endif()
  list(GET POINTS ${_cl} _pts)
  math(EXPR score "${score} + ${_pts} * (${lines} / 10 + 1)")
  math(EXPR lines "${lines} + ${_cl}")
  set(cur ${nxt})
  draw()
  spawn()
endmacro()

macro(down)
  math(EXPR _ny "${y} + 1")
  fits(${x} ${_ny} ${r})
  if(ok)
    set(y ${_ny})
  else()
    lock()
  endif()
endmacro()

macro(shift _dx)
  math(EXPR _nx "${x} + ${_dx}")
  fits(${_nx} ${y} ${r})
  if(ok)
    set(x ${_nx})
  endif()
endmacro()

macro(rotate)
  math(EXPR _nr "(${r} + 1) % 4")
  foreach(_kick IN LISTS KICKS)
    math(EXPR _nx "${x} + ${_kick}")
    fits(${_nx} ${y} ${_nr})
    if(ok)
      set(x ${_nx})
      set(r ${_nr})
      break()
    endif()
  endforeach()
endmacro()

macro(drop)
  while(TRUE)
    math(EXPR _ny "${y} + 1")
    fits(${x} ${_ny} ${r})
    if(NOT ok)
      break()
    endif()
    set(y ${_ny})
  endwhile()
  lock()
endmacro()

# ---- rendering --------------------------------------------------------------------
macro(render)
  if(NOT over)
    math(EXPR _v "${cur} + 1")
    paint(${_v})
  endif()
  set(_f "${ESC}[H  ${ESC}[1;38;5;75mC M A K E T R I S${R}${K}")
  string(APPEND _f " ${B}╔════════════════════╗${R}${K}")
  math(EXPR _lv "${lines} / 10 + 1")
  math(EXPR _nm "${nxt} * 4")
  list(GET MASKS ${_nm} _nmask)
  math(EXPR _nv "${nxt} + 1")
  foreach(_row RANGE 19)
    string(APPEND _f " ${B}║${R}")
    if(over AND _row EQUAL 9)
      string(APPEND _f "${ESC}[1;7m     GAME  OVER     ${R}")
    else()
      foreach(_j RANGE 9)
        math(EXPR _k "${_row} * 10 + ${_j}")
        string(APPEND _f "${cell_${b_${_k}}}")
      endforeach()
    endif()
    string(APPEND _f "${B}║${R}")
    if(_row GREATER_EQUAL 2 AND _row LESS_EQUAL 5)
      string(APPEND _f "   ${B}│${R}   ")
      foreach(_q RANGE 3)
        math(EXPR _bit "(${_nmask} >> ((${_row} - 2) * 4 + ${_q})) & 1")
        if(_bit)
          string(APPEND _f "${cell_${_nv}}")
        else()
          string(APPEND _f "  ")
        endif()
      endforeach()
      string(APPEND _f "   ${B}│${R}")
    elseif(_row EQUAL 10)
      string(APPEND _f "   ${W}${score}${R}")
    elseif(_row EQUAL 11)
      string(APPEND _f "   ${D}level${R} ${W}${_lv}${R}  ${D}lines${R} ${W}${lines}${R}")
    elseif(DEFINED panel_${_row})
      string(APPEND _f "${panel_${_row}}")
    endif()
    string(APPEND _f "${K}")
  endforeach()
  string(APPEND _f " ${B}╚════════════════════╝${R}${K}")
  file(APPEND /dev/stdout "${_f}")
  if(NOT over)
    paint(0)
  endif()
endmacro()

# ---- main loop -----------------------------------------------------------------------
set(started 0)
set(done 0)
set(pass 0)
while(NOT done)
  file(DOWNLOAD "file://${FIFO}.${pass}" "${SCRATCH}")
  file(READ "${SCRATCH}" input)
  math(EXPR pass "${pass} + 1")
  string(REGEX MATCHALL "-?[0-9]+" events "${input}")
  list(LENGTH events count)
  if(count EQUAL 0)                           # an empty write means end of input
    break()                                   # (not if(NOT events): "0" is false)
  endif()
  foreach(e IN LISTS events)
    if(NOT started)
      set(s ${e})
      foreach(k RANGE 199)
        set(b_${k} 0)
      endforeach()
      set(score 0)
      set(lines 0)
      set(over 0)
      draw()
      set(cur ${nxt})
      draw()
      spawn()
      set(started 1)
      render()
      continue()
    endif()
    if(e EQUAL 9)
      set(done 1)
      break()
    endif()
    set(emit 1)
    if(e EQUAL 0)
      math(EXPR t "${t} + 1")
      math(EXPR _g "${t} + ${lines} / 10")
      if(_g GREATER_EQUAL 10)
        set(t 0)
        down()
      else()
        set(emit 0)
      endif()
    elseif(e EQUAL 1)
      shift(-1)
    elseif(e EQUAL 2)
      shift(1)
    elseif(e EQUAL 3)
      rotate()
    elseif(e EQUAL 4)
      down()
    elseif(e EQUAL 5)
      drop()
    else()
      set(emit 0)
    endif()
    if(emit)
      render()
      if(over)
        set(done 1)
        break()
      endif()
    endif()
  endforeach()
endwhile()
