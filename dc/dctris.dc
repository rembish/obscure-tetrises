# one board row: cells, or the banner on row 9 when the game is over
[la10*lj+;Bsh lh0=" lh0!=` lj1+dsj10>l]sl
[0sjllx]s6
[l^x[1;7m]P[     GAME  OVER     ]PlRx]s9
[[ ]Pl<x[║]PlRx la100*lo+901=9 la100*lo+901!=6 l<x[║]PlRx la;Gx l-x la1+dsa20>O]sO
[lc1+shlHx]s7
[0shlHx]s8
[lo0=7 l^x[H]P [  ]Pl^x[1;38;5;75m]P[D C T R I S]PlRx l-x
 [ ]Pl<x[╔════════════════════╗]PlRx l-x
 0salOx
 [ ]Pl<x[╚════════════════════╝]PlRx l-x
 l^x[J]P lo0=8]sZ

# ---- main loop ----------------------------------------------------------------
# `?` reads one line. A sentinel (-1) underneath tells EOF apart from input.
[q]sQ
[_1? d_1=Q r s_ sz lz9=Q 0se lz0=0 lz1=1 lz2=2 lz3=3 lz4=4 lz5=5 le1=Z lo1=Q lWx]sW

_1? d_1=Q r s_ ss
0sS 0sL 0so 19sb 0sj l{x
lDx lnsc lDx lNx lZx
lWx
