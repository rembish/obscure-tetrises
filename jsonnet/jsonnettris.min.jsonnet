else if E==4 then s(g)+{w:1}else if E==5 then h(g)+{w:1}else g{w:0},
g=if o==null then local s=d(I);n({seed:s,next:s%7,board:std.repeat([0],20),score:0,lines:0})+{w:1}else e(o,I),
X='\u001b[',B(s)=X+'38;5;60m'+s+X+'m',D(s)=X+'38;5;244m'+s+X+'m',T(s)=X+'1m'+s+X+'m',
