PANEL{
   <Esc>[38;5;60m╭──<Esc>[m <Esc>[38;5;244mnext<Esc>[m <Esc>[38;5;60m──────╮<Esc>[m
   <Esc>[38;5;60m│<Esc>[m              <Esc>[38;5;60m│<Esc>[m
